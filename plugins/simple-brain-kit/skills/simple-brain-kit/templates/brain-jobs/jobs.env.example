# brain-jobs settings. Copy to ~/.config/brain-jobs/env (mode 600). Never commit the copy.

# The vault clone that brain-mcp serves and sync.sh keeps in step
BRAIN_VAULT=/srv/brain/vault

# Task tracker adapter: vikunja | jira | linear | github | none
BRAIN_TRACKER=none
# Link shown in the morning summary instead of task titles (optional)
BRAIN_TRACKER_URL=
# Vikunja (worked example): an API token that can create and read tasks
VIKUNJA_URL=https://tasks.example.org
VIKUNJA_TOKEN=
VIKUNJA_PROJECT_ID=

# Notification adapter: stdout | telegram | slack | email
BRAIN_NOTIFY=stdout
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Jobs the morning summary expects a run log for (missing ones are reported)
BRAIN_EXPECTED_JOBS=curate,verify,inspire

# --- brain_health.py (nightly, after the index job, before the morning summary) ---
# Lanes, relative to the vault (match AGENTS.md if you renamed them)
BRAIN_LANE_RAW=raw
BRAIN_LANE_TOPICS=topics
BRAIN_LANE_TRANSCRIPTS=transcripts
BRAIN_LANE_CAPTURES=inbox/captures
BRAIN_LANE_RUNS=ops/runs
# Wikilinks in these folders are not lint targets (speakers quote, logs and templates mention links)
BRAIN_LINK_SKIP_SOURCES=transcripts/,ops/,templates/
# The owner's priorities page: only its age is checked, it is never written
BRAIN_PRIORITIES_PATH=topics/priorities.md
BRAIN_PRIORITIES_MAX_DAYS=30
# Run-log job name that counts as a curation night
BRAIN_CURATE_JOB=curate
# Words ignored when comparing page names for near-duplicates (comma separated)
BRAIN_DUP_STOPWORDS=
# History (one JSON line per day) and the item-list report: both stay on this host
BRAIN_HEALTH_HISTORY=~/.local/state/brain-health/history.jsonl
BRAIN_HEALTH_REPORT=~/.local/state/brain-health/latest.md

# Index drift check: none | postgrest | <module>:<factory> (see index_adapters.py)
BRAIN_INDEX_ADAPTER=none
# postgrest: the chunk table URL and a select-only key; brain_core from the brain-mcp folder
BRAIN_INDEX_URL=
BRAIN_INDEX_KEY=
BRAIN_MCP_DIR=/srv/brain/brain-mcp
BRAIN_EXCLUDE=
# <module>:<factory>: folder that holds your indexer's adapter module
BRAIN_INDEX_ADAPTER_PATH=
# When did the last index run start? A file the indexer writes (ISO 8601), else its schedule (UTC)
BRAIN_INDEX_LAST_RUN_FILE=
BRAIN_INDEX_SCHEDULE=03:15
