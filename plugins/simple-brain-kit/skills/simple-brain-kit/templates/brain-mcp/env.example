# brain-mcp configuration. ./setup_secrets.sh copies this to .env and fills the secrets.
# Never commit .env.

# Host side (docker compose)
# a git clone of the vault on this server
VAULT_DIR=/srv/brain/vault
# owner of VAULT_DIR on the host: `id -u`
BRAIN_UID=1000
# `id -g`
BRAIN_GID=1000
BRAIN_PORT=8765

# Read-only endpoint: <public URL><BRAIN_READ_PATH>/mcp
BRAIN_READ_PATH=
BRAIN_READ_KEY=
# no key: ONLY when the server is reachable on a private network alone
# BRAIN_READ_OPEN=1

# Capture endpoint (optional): <public URL><BRAIN_CAPTURE_PATH>/mcp. Leave both empty to disable.
BRAIN_CAPTURE_PATH=
BRAIN_CAPTURE_KEY=

# Public hostname(s) behind your proxy or tunnel, comma separated, e.g. brain.example.org.
# Empty = Host-header check off (fine when a reverse proxy already pins the Host).
BRAIN_ALLOWED_HOSTS=

# Folders tools must never read, comma-separated globs relative to the vault, e.g. clients/*,hr
BRAIN_EXCLUDE=

# Optional hybrid search: any OpenAI-compatible /v1/embeddings endpoint. Prefer a self-hosted
# model (e.g. Ollama) when the vault holds client or personal data: every chunk is sent to it.
BRAIN_EMBED_URL=
BRAIN_EMBED_MODEL=nomic-embed-text
BRAIN_EMBED_KEY=

# Or an external vector store adapter (Supabase/pgvector, Qdrant, ...) behind one HTTP endpoint:
# POST {"query", "limit"} -> {"results": [{"path"}]}. Wins over BRAIN_EMBED_URL. See references/architecture.md.
BRAIN_VECTOR_URL=
BRAIN_VECTOR_KEY=
